---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import DevPalette from '../components/DevPalette.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  navOverlay?: boolean;
  navHideCta?: boolean;
}

const { title, description = "Brynn Caputo — experience designer.", navOverlay = false, navHideCta = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} — Brynn Caputo</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-paper font-sans text-ink antialiased">
    <Nav overlay={navOverlay} hideCta={navHideCta} />
    <main>
      <slot />
    </main>
    <Footer />
    {import.meta.env.DEV && <DevPalette />}
  </body>
</html>
