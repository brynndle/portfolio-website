---
interface Props {
  title: string;
  blurb: string;
  href: string;
  thumbnail?: string;
  external?: boolean;
  /** "light" (default) sits on the base background; "dark" is the plum accent card. */
  variant?: 'light' | 'dark';
  size?: 'default' | 'large';
}

const {
  title,
  blurb,
  href,
  thumbnail,
  external = false,
  variant = 'light',
  size = 'default',
} = Astro.props;

const isDark = variant === 'dark';
const isLarge = size === 'large';
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class:list={[
    'group flex flex-col justify-between border border-ink/10 transition-colors',
    isDark ? 'bg-plum text-base' : 'bg-base text-ink hover:border-plum',
    isLarge ? 'min-h-[22rem]' : 'min-h-[18rem]',
  ]}
>
  {thumbnail && (
    <img
      src={thumbnail}
      alt=""
      class:list={['w-full object-cover', isLarge ? 'h-64' : 'h-48']}
      loading="lazy"
    />
  )}
  <div class="flex flex-1 flex-col justify-between gap-4 p-6">
    <div>
      <h3 class:list={['font-display text-2xl font-bold', isLarge && 'text-3xl']}>
        {title}
      </h3>
      <p class:list={['mt-3 font-body text-sm leading-relaxed', isDark ? 'text-base/80' : 'text-ink/70']}>
        {blurb}
      </p>
    </div>
    <span
      class:list={[
        'font-display text-sm font-bold uppercase tracking-wide',
        isDark ? 'text-base' : 'text-plum',
        'group-hover:underline',
      ]}
    >
      {external ? 'Visit →' : 'Explore →'}
    </span>
  </div>
</a>
