---
// src/components/CheckoutOffer.astro
import type { CheckoutTier } from '../data/checkoutTiers';

interface Props {
  tier: CheckoutTier;
}
const { tier } = Astro.props;
---
<section class="max-width border-b border-rule px-5 py-12 md:px-10">
  <div class="label mb-3 text-blue">{tier.persona}</div>
  <h1 class="max-w-[20ch] text-[2.5rem] font-semibold leading-[1.05] -tracking-[0.02em] text-balance max-md:text-3xl">1-Hour UX Consult</h1>
  <p class="mt-6 max-w-[64ch] text-lg leading-relaxed text-ink-2 text-pretty">{tier.blurb}</p>
  <p class="mt-6 font-mono text-2xl font-bold text-ink">${tier.price}</p>
  {tier.paymentLinkUrl ? (
    <a
      href={tier.paymentLinkUrl}
      class="mt-8 inline-block whitespace-nowrap bg-[#00ff1c] px-[26px] py-4 text-center font-mono text-[0.9375rem] font-bold uppercase tracking-[0.1em] text-ink shadow-[5px_5px_0px_rgba(0,0,0,0.5)]"
    >
      Proceed to payment →
    </a>
  ) : (
    <p class="mt-8 inline-block border border-rule-strong bg-paper-2 px-5 py-3 font-mono text-[0.8125rem] font-bold uppercase tracking-[0.1em] text-ink-3">
      Checkout is not configured in this environment
    </p>
  )}
</section>

<section class="max-width border-b border-rule px-5 py-12 md:px-10">
  <h2 class="text-[1.375rem] font-semibold -tracking-[0.01em]">What you get</h2>
  <ul class="mt-6 max-w-[64ch] space-y-3 text-lg leading-relaxed text-ink-2">
    <li>A full audit of your product or website — copy, accessibility, and the friction points losing you customers</li>
    <li>Direct, specific feedback and advice on UX and product design decisions</li>
    <li>Prioritized recommendations, not a vague list — what to fix first and why</li>
    <li>Answers to whatever direct issues you're already stuck on</li>
  </ul>
</section>

<section class="max-width border-b border-rule px-5 py-12 md:px-10">
  <h2 class="text-[1.375rem] font-semibold -tracking-[0.01em]">The process</h2>
  <ol class="mt-8 space-y-8 border-t border-rule pt-8">
    <li class="border-l border-rule-strong pl-6">
      <p class="label text-blue">1</p>
      <h3 class="mt-1.5 text-xl font-semibold -tracking-[0.01em]">Pay</h3>
      <p class="mt-2 max-w-[64ch] text-[0.9375rem] leading-relaxed text-ink-2">Checkout above, secured by Stripe.</p>
    </li>
    <li class="border-l border-rule-strong pl-6">
      <p class="label text-blue">2</p>
      <h3 class="mt-1.5 text-xl font-semibold -tracking-[0.01em]">Give me the info</h3>
      <p class="mt-2 max-w-[64ch] text-[0.9375rem] leading-relaxed text-ink-2">Right after payment, tell me about your product — links, files, and what's going wrong.</p>
    </li>
    <li class="border-l border-rule-strong pl-6">
      <p class="label text-blue">3</p>
      <h3 class="mt-1.5 text-xl font-semibold -tracking-[0.01em]">I follow up if I need to</h3>
      <p class="mt-2 max-w-[64ch] text-[0.9375rem] leading-relaxed text-ink-2">If I need more context before the audit, I'll reach out with specific questions.</p>
    </li>
    <li class="border-l border-rule-strong pl-6">
      <p class="label text-blue">4</p>
      <h3 class="mt-1.5 text-xl font-semibold -tracking-[0.01em]">I deliver the goods</h3>
      <p class="mt-2 max-w-[64ch] text-[0.9375rem] leading-relaxed text-ink-2">You get the audit and the changes that matter most, with the reasoning behind them.</p>
    </li>
  </ol>
</section>

<section class="max-width px-5 py-12 md:px-10">
  <h2 class="text-[1.375rem] font-semibold -tracking-[0.01em]">About Brynn</h2>
  <p class="mt-6 max-w-[64ch] text-lg leading-relaxed text-ink-2 text-pretty">
    I'm a product and experience designer with over a decade of experience — most recently as
    Senior Product Designer at Garner Health and Side Inc., with earlier work at Habitat for
    Humanity, MustWin, Perka, and See.Me. I've done this kind of audit work for teams of every
    size, from solo builders to funded startups.
  </p>
</section>
