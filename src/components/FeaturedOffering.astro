---
import { UX_OFFERS } from '../data/uxOffers';

---
<article class="grid grid-cols-[1fr_auto] items-stretch overflow-hidden rounded-[10px] border border-rule-strong bg-card shadow-plate max-lg:grid-cols-1">
  <!-- what the service is -->
  <div class="border-r border-rule p-5 lg:px-8 lg:py-7 max-lg:border-b max-lg:border-r-0">
    <div class="mb-4 flex items-center gap-2.5">
      <span class="bg-ink px-2 py-[5px] font-mono text-xs font-semibold uppercase tracking-[0.18em] text-paper">UX services</span>
    </div>
    <h3 class="text-[1.75rem] font-semibold leading-[1.12] -tracking-[0.025em] text-balance">A fresh set of eyes on your product.</h3>
    <p class="mt-3 text-[1.125rem] leading-[1.62] text-ink-2 text-pretty">I find where people get confused, stuck, or drop off, then help you decide what to fix.</p>
  </div>

  <!-- the action -->
  <div class="flex flex-col items-center justify-center gap-2.5 bg-slate p-5 text-center lg:px-8 lg:py-7">
    <span class="font-mono text-[0.7188rem] font-medium uppercase tracking-[0.12em] text-accent">Two ways to work together</span>
    <a href="/ux-services" class="w-full max-w-[280px] whitespace-nowrap bg-[#00ff1c] px-7 py-4 text-center font-mono text-[0.9062rem] font-bold uppercase tracking-[0.1em] text-ink shadow-[5px_5px_0px_rgba(0,0,0,0.5)]">Explore UX services →</a>
    <span class="font-mono text-[0.8125rem] text-ink">{UX_OFFERS.review.priceLabel} review · {UX_OFFERS.engagement.priceLabel.toLowerCase()}</span>
  </div>
</article>
