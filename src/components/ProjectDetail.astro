---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'work' | 'games' | 'experiences'>;
  backHref: string;
  backLabel: string;
}

const { entry, backHref, backLabel } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.blurb}>
  <article class="mx-auto max-w-3xl px-6 py-16">
    <a href={backHref} class="font-display text-sm font-bold uppercase tracking-wide text-plum hover:underline">
      ← {backLabel}
    </a>
    <h1 class="mt-6 font-display text-4xl font-bold md:text-5xl">{entry.data.title}</h1>
    {entry.data.link && (
      <a
        href={entry.data.link}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-block bg-cta px-5 py-2.5 font-display text-sm font-bold uppercase tracking-wide text-base hover:bg-cta-dark"
      >
        Visit →
      </a>
    )}
    <div
      class="prose prose-lg mt-10 max-w-none font-body leading-relaxed
             prose-headings:font-display prose-headings:font-bold
             prose-img:w-full prose-img:border prose-img:border-ink/10
             prose-a:text-plum"
    >
      <Content />
    </div>
  </article>
</BaseLayout>
