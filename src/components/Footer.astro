---
import { BOOK_A_CONSULT_URL, AVAILABLE } from '../data/site';
const columns = [
  { head: 'Work', links: [['Project catalog', '/work'], ['Case studies', '/work'], ['Games', '/games'], ['Experiences', '/experiences']] },
  { head: 'More', links: [["What I'm working on", '/#board'], ['About', '/about']] },
  { head: 'Elsewhere', links: [['Email', 'mailto:hi@brynncaputo.com'], ['Instagram', 'https://www.instagram.com/brynndlebop'], ['TikTok', 'https://www.tiktok.com/@brynndlebop']] },
];
const SOCIAL_ICONS: Record<string, string> = {
  Instagram: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>',
  TikTok: '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 2h-3v13.5a3 3 0 1 1-2.5-2.96V9.4a6 6 0 1 0 5.5 5.98V9.03a7.4 7.4 0 0 0 4.5 1.53v-3a4.4 4.4 0 0 1-4.5-4.4V2z"/></svg>',
};
---
<footer class="bg-ink text-paper">
  <div class="max-width grid grid-cols-[1.4fr_1fr_1fr_1fr] gap-12 border-b border-rule-invert px-10 pb-11 pt-13 max-md:grid-cols-2">
    <div>
      <div class="text-xl font-semibold -tracking-[0.015em]">Brynn Caputo</div>
      <p class="mt-3 max-w-[34ch] text-[14.5px] leading-relaxed text-paper/60 text-pretty">Product and experience design. Currently taking two consult slots a month to help fix other people's projects.</p>
      {AVAILABLE && (
        <div class="mt-[18px] flex items-center gap-2.5">
          <span class="block h-2.5 w-2.5 bg-green-dark"></span>
          <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-green-dark">Available for work</span>
        </div>
      )}
    </div>
    {columns.map((col) => (
      <div class="flex flex-col gap-3">
        <div class="mb-0.5 font-mono text-[11px] uppercase tracking-[0.14em] text-paper/45">{col.head}</div>
        {col.links.map(([label, href]) => (
          <a href={href} class="flex items-center gap-2 text-[14.5px] text-paper/85 transition-colors duration-100 hover:text-paper">
            {SOCIAL_ICONS[label] && <Fragment set:html={SOCIAL_ICONS[label]} />}
            {label}
          </a>
        ))}
      </div>
    ))}
  </div>
  <div class="max-width grid grid-cols-[1fr_auto] items-center gap-8 px-10 pb-[30px] pt-[26px] max-md:grid-cols-1">
    <div class="flex flex-wrap gap-6 font-mono text-[11px] uppercase tracking-[0.1em] text-paper/45">
      <span>© {new Date().getFullYear()} Brynn Caputo</span>
    </div>
    <a href={BOOK_A_CONSULT_URL} class="whitespace-nowrap bg-[#00ff1c] px-6 py-3.5 font-mono text-[14px] font-bold uppercase tracking-[0.1em] text-ink shadow-[5px_5px_0px_rgba(0,0,0,0.5)]">Book a consult →</a>
  </div>
</footer>
