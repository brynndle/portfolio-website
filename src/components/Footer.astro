---
const socials = [
  { href: 'http://www.dribbble.com/davecaputo', label: 'Dribbble' },
  { href: 'https://medium.com/@brynncaputo', label: 'Medium' },
  { href: 'https://github.com/brynndle', label: 'GitHub' },
];
---

<footer class="mt-24 border-t border-ink/10">
  <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-4 px-6 py-10 md:flex-row md:items-center">
    <p class="font-body text-sm text-ink/60">
      &copy; {new Date().getFullYear()} Brynn Caputo
    </p>
    <nav class="flex gap-6 font-display text-sm uppercase tracking-wide">
      {socials.map((s) => (
        <a href={s.href} class="hover:text-plum" target="_blank" rel="noopener noreferrer">
          {s.label}
        </a>
      ))}
    </nav>
  </div>
</footer>
