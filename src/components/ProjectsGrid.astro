---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { TAGS, tagToSlug, type Tag } from '../data/tags';

interface Props {
  title: string;
  intro?: string;
  entries: CollectionEntry<'work' | 'games' | 'experiences'>[];
  initialTag?: Tag;
}

const { title, intro, entries, initialTag } = Astro.props;
const COLLECTION_RANK: Record<'work' | 'games' | 'experiences', number> = { work: 0, games: 1, experiences: 2 };
const sorted = [...entries].sort((a, b) =>
  Number(b.data.featured) - Number(a.data.featured) ||
  COLLECTION_RANK[a.collection] - COLLECTION_RANK[b.collection] ||
  a.data.order - b.data.order
);

const sections = TAGS.map((tag) => {
  const slug = tagToSlug(tag);
  return {
    tag,
    slug,
    entries: sorted.filter((entry) => entry.data.tags.map(tagToSlug).includes(slug)),
  };
}).filter((section) => section.entries.length > 0);

const initialSlug = initialTag ? tagToSlug(initialTag) : undefined;
---

<BaseLayout title={title} description={intro}>
  <section class="max-width border-b border-rule px-5 py-12 md:px-10">
    <div class="label mb-3 text-blue">Catalog</div>
    <h1 class="max-w-[24ch] text-[2.5rem] font-semibold leading-[1.05] -tracking-[0.02em] text-balance max-md:text-3xl">{title}</h1>
    {intro && <p class="mt-4 max-w-[75ch] text-lg leading-relaxed text-ink-2 text-pretty">{intro}</p>}
  </section>

  <section aria-label="Jump to section" class="max-width border-b border-rule px-5 py-6 md:px-10">
    <div class="label mb-3 text-ink-3">Jump to section</div>
    <div class="flex flex-wrap gap-2.5">
      {sections.map(({ tag, slug }) => (
        <a href={`#${slug}`} data-jump-link class="label border border-rule-strong px-3.5 py-2 text-ink-2 transition-colors duration-100 hover:border-blue hover:text-blue">{tag}</a>
      ))}
    </div>
  </section>

  {sections.map(({ tag, slug, entries: sectionEntries }) => (
    <section id={slug} class="max-width scroll-mt-[calc(var(--nav-height)+16px)] border-b border-rule px-5 py-12 last:border-b-0 md:px-10">
      <h2 class="mb-6 text-[1.5rem] font-semibold -tracking-[0.01em]">{tag}</h2>
      <div class="grid gap-[40px] md:grid-cols-4">
        {sectionEntries.map((entry) => (
          <a
            href={`/${entry.collection}/${entry.id}`}
            class="block overflow-hidden rounded-[10px] bg-paper-3 shadow-[var(--shadow-plate-soft)]"
          >
            <div class="relative flex aspect-square items-end overflow-hidden bg-paper-2 p-3">
              {entry.data.thumbnail
                ? <img src={entry.data.thumbnail} alt="" class="absolute inset-0 h-full w-full object-cover" />
                : <span class="label text-[0.875rem]">image</span>}
            </div>
            <div class="p-5">
              <h3 class="text-lg font-semibold -tracking-[0.01em]">{entry.data.listTitle ?? entry.data.title}</h3>
              <p class="mt-2 text-[0.8438rem] leading-relaxed text-ink-3">{entry.data.blurb}</p>
              <span class="mt-4 inline-block border-b border-ink-3/60 pb-[3px] font-mono text-xs font-bold uppercase tracking-[0.1em] text-ink-3">See more →</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  ))}
</BaseLayout>

<script define:vars={{ initialSlug }}>
  document.querySelectorAll('[data-jump-link]').forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const slug = link.getAttribute('href').slice(1);
      document.getElementById(slug)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      history.pushState(null, '', `#${slug}`);
    });
  });

  if (initialSlug) {
    document.getElementById(initialSlug)?.scrollIntoView({ behavior: 'instant', block: 'start' });
  }
</script>
