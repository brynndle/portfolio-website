---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

interface Props {
  title: string;
  moreHref: string;
  moreLabel: string;
}

const { title, moreHref, moreLabel } = Astro.props;

const games = (await getCollection('games')).sort((a, b) => a.data.order - b.data.order);
const experiences = (await getCollection('experiences')).sort((a, b) => a.data.order - b.data.order);

const featuredGame = games.find((g) => g.data.featured) ?? games[0];
const featuredExperience = experiences.find((e) => e.data.featured) ?? experiences[0];
---

<section class="border-b border-rule px-10 py-12">
  <div class="mb-6 flex items-baseline justify-between">
    <h3 class="text-[22px] font-semibold -tracking-[0.01em]">{title}</h3>
    <a href={moreHref} class="label text-blue">{moreLabel}</a>
  </div>
  <div class="grid gap-6 md:grid-cols-3">
    <ProjectCard
      title="Vibe Code Rescue"
      blurb="AI ships fast. It doesn't know your users, your flow, or why anyone would click that button. A one-hour session fixes the experience so the product works as well as it looks."
      href="https://brynndle.github.io/ux-rescue/"
      kicker="Consult"
      variant="service"
    />
    {featuredGame && (
      <ProjectCard
        title={featuredGame.data.title}
        blurb={featuredGame.data.blurb}
        href={`/games/${featuredGame.id}`}
        thumbnail={featuredGame.data.thumbnail}
        kicker="Game"
      />
    )}
    {featuredExperience && (
      <ProjectCard
        title={featuredExperience.data.title}
        blurb={featuredExperience.data.blurb}
        href={`/experiences/${featuredExperience.id}`}
        thumbnail={featuredExperience.data.thumbnail}
        kicker="Experience"
      />
    )}
  </div>
</section>
