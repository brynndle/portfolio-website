---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

interface Props {
  title: string;
  moreHref: string;
  moreLabel: string;
}

const { title, moreHref, moreLabel } = Astro.props;

const games = (await getCollection('games')).sort((a, b) => a.data.order - b.data.order);
const experiences = (await getCollection('experiences')).sort((a, b) => a.data.order - b.data.order);

const featuredGame = games.find((g) => g.data.featured) ?? games[0];
const featuredExperience = experiences.find((e) => e.data.featured) ?? experiences[0];
const itAlreadyHappened = games.find((g) => g.id === 'it-already-happened');
---

<section class="relative -mt-[65px] overflow-hidden">
  <div class="band-bg diagonal-cut-projects absolute inset-0" aria-hidden="true"></div>

  <div class="max-width relative px-10 pb-[145px] pt-[120px] lg:pt-[262px]">
    <div class="mb-6 flex items-baseline justify-between">
      <h3 class="font-display text-[32px] font-normal -tracking-[0.01em]">{title}</h3>
      <a href={moreHref} class="label font-bold text-blue">{moreLabel}</a>
    </div>
    <div class="grid gap-[40px] md:grid-cols-3">
      {itAlreadyHappened && (
        <ProjectCard
          title={itAlreadyHappened.data.title}
          blurb={itAlreadyHappened.data.blurb}
          href={`/games/${itAlreadyHappened.id}`}
          thumbnail={itAlreadyHappened.data.thumbnail}
          kicker="Game"
        />
      )}
      {featuredGame && (
        <ProjectCard
          title={featuredGame.data.title}
          blurb={featuredGame.data.blurb}
          href={`/games/${featuredGame.id}`}
          thumbnail={featuredGame.data.thumbnail}
          kicker="Game"
        />
      )}
      {featuredExperience && (
        <ProjectCard
          title={featuredExperience.data.title}
          blurb={featuredExperience.data.blurb}
          href={`/experiences/${featuredExperience.id}`}
          thumbnail={featuredExperience.data.thumbnail}
          kicker="Experience"
        />
      )}
    </div>
  </div>
</section>
