---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from './ProjectCard.astro';

interface Props {
  title: string;
  intro?: string;
  basePath: string;
  entries: CollectionEntry<'work' | 'games' | 'experiences'>[];
}

const { title, intro, basePath, entries } = Astro.props;
const sorted = [...entries].sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={title} description={intro}>
  <section class="max-width border-b border-rule px-5 py-12 md:px-10">
    <div class="label mb-3 text-blue">Catalog</div>
    <h1 class="max-w-[24ch] text-[2.5rem] font-semibold leading-[1.05] -tracking-[0.02em] text-balance max-md:text-3xl">{title}</h1>
    {intro && <p class="mt-4 max-w-[60ch] text-lg leading-relaxed text-ink-2 text-pretty">{intro}</p>}
  </section>
  <section class="max-width px-5 py-12 md:px-10">
    <div class="grid gap-6 md:grid-cols-3">
      {sorted.map((entry) => (
        <ProjectCard
          title={entry.data.listTitle ?? entry.data.title}
          blurb={entry.data.blurb}
          href={`${basePath}/${entry.id}`}
          thumbnail={entry.data.thumbnail}
        />
      ))}
    </div>
  </section>
</BaseLayout>
