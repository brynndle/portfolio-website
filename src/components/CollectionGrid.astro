---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from './ProjectCard.astro';

interface Props {
  title: string;
  intro?: string;
  basePath: string;
  entries: CollectionEntry<'work' | 'games' | 'experiences'>[];
}

const { title, intro, basePath, entries } = Astro.props;
const sorted = [...entries].sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={title}>
  <section class="mx-auto max-w-6xl px-6 pt-16 pb-12">
    <h1 class="font-display text-4xl font-bold md:text-5xl">{title}</h1>
    {intro && <p class="mt-4 max-w-2xl font-body text-lg text-ink/70">{intro}</p>}
  </section>
  <section class="mx-auto max-w-6xl px-6 pb-24">
    <div class="grid gap-6 md:grid-cols-3">
      {sorted.map((entry) => (
        <ProjectCard
          title={entry.data.title}
          blurb={entry.data.blurb}
          href={`${basePath}/${entry.id}`}
          thumbnail={entry.data.thumbnail}
        />
      ))}
    </div>
  </section>
</BaseLayout>
