---
import FeaturedOffering from './FeaturedOffering.astro';
const { headline, lede } = Astro.props;
---
<section class="relative pt-[var(--nav-height)]">
  <div class="hero-bg diagonal-cut-hero absolute inset-0" aria-hidden="true"></div>
  <div
    class="diagonal-cut-hero pointer-events-none absolute inset-0 opacity-40"
    style="background-image:url('/mist.png'); background-size:300px 300px;"
    aria-hidden="true"
  ></div>

  <div class="max-width relative flex flex-col justify-start">
    <div class="flex max-w-[62rem] flex-col justify-center px-11 pb-12 pt-12 lg:pb-[200px]">
      <p id="hero-eyebrow" class="font-mono text-lg font-semibold uppercase tracking-[0.08em] text-white/90 max-md:text-base">Brynn Caputo — Experience &amp; Product Design</p>
      <h2 class="mt-5 max-w-[34ch] font-display text-[79px] font-normal leading-[1.02] -tracking-[0.03em] text-balance text-white [text-shadow:-3px_-3px_0_rgb(0_0_0_/_0.10)] max-md:text-[40px]">{headline}</h2>
      <p class="mt-5 max-w-[62ch] pb-[54px] text-[22px] leading-relaxed text-white text-pretty">{lede}</p>
    </div>

    <div class="absolute inset-x-11 bottom-[36px] z-10 translate-y-1/2 max-lg:static max-lg:bottom-auto max-lg:mx-11 max-lg:mb-8 max-lg:translate-y-0">
      <FeaturedOffering />
    </div>
  </div>
</section>
