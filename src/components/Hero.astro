---
import FeaturedOffering from './FeaturedOffering.astro';
const { headline, lede } = Astro.props;
---
<section class="relative pb-[30px] pt-[calc(var(--nav-height)+80px)]">
  <div class="hero-bg diagonal-cut-hero absolute inset-0" aria-hidden="true"></div>
  <div
    class="diagonal-cut-hero pointer-events-none absolute inset-0 opacity-40"
    style="background-image:url('/mist.png'); background-size:300px 300px;"
    aria-hidden="true"
  ></div>

  <div class="max-width relative flex flex-col justify-start">
    <div class="mx-auto flex w-[86%] flex-col items-center justify-center px-11 pb-12 pt-12 text-center max-md:w-full lg:pb-[280px]">
      <p id="hero-eyebrow" class="font-mono text-lg font-semibold uppercase tracking-[0.08em] text-white/90 max-md:text-base">UX Design · Product Strategy · Experience Design</p>
      <h2 class="mt-5 font-display text-[96px] font-[600] leading-[1.02] -tracking-[0.03em] text-balance text-white [text-shadow:5px_5px_0_rgba(0,0,0,.24)] max-md:text-[56px]">{headline}</h2>
      <p class="mt-5 w-[83%] pb-[54px] whitespace-pre-line text-[24px] leading-relaxed text-white text-pretty [text-shadow:2px_2px_7px_rgba(0,0,0,.6)] max-md:w-full">{lede}</p>
    </div>

    <div class="absolute inset-x-11 bottom-[36px] z-10 translate-y-1/2 max-lg:static max-lg:bottom-auto max-lg:mx-11 max-lg:mb-8 max-lg:translate-y-0">
      <FeaturedOffering />
    </div>
  </div>
</section>
