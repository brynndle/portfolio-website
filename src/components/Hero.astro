---
import FeaturedOffering from './FeaturedOffering.astro';
import '@fontsource/dongle/400.css';
const { headline, lede } = Astro.props;
---
<section class="relative pb-[26px] pt-[calc(var(--nav-height)+68px)] max-lg:pb-0 max-md:pt-[97px]">
  <div class="hero-bg diagonal-cut-hero absolute inset-0" aria-hidden="true"></div>
  <div
    class="diagonal-cut-hero pointer-events-none absolute inset-0 opacity-40"
    style="background-image:url('/mist.png'); background-size:300px 300px;"
    aria-hidden="true"
  ></div>
  <div
    class="diagonal-cut-hero pointer-events-none absolute inset-0"
    style="background:radial-gradient(circle at center, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0) 70%);"
    aria-hidden="true"
  ></div>

  <div class="max-width relative flex flex-col justify-start">
    <div class="mx-auto flex w-[86%] flex-col items-center justify-center px-5 pb-[210px] pt-0 text-center max-md:w-full max-md:pb-[176px] md:px-11 lg:pb-[180px]">
      <p id="hero-eyebrow" class="font-['Dongle'] text-xl font-semibold uppercase tracking-[0.08em] text-white/90 max-md:w-full max-md:border-t max-md:border-white/25 max-md:pb-0 max-md:pt-10 max-md:text-base max-md:leading-[.5]">UX Design · Product Strategy · Experience Design</p>
      <h2 class="mt-5 font-['Dongle'] text-[7.65rem] font-normal leading-[0.63] -tracking-[0.03em] text-balance text-white [text-shadow:5px_5px_0_rgba(0,0,0,.24)] max-md:text-[5.35rem]">{headline}</h2>
      <p class="mt-5 w-[83%] pb-[46px] whitespace-pre-line font-['Dongle'] text-[2rem] leading-[.8] text-white text-pretty [text-shadow:2px_2px_7px_rgba(0,0,0,.6)] max-md:w-full max-md:text-[1.75rem] max-md:leading-[.8]">{lede}</p>
    </div>

    <div class="absolute inset-x-11 bottom-[36px] z-10 translate-y-1/2 max-lg:inset-x-5 max-lg:bottom-0">
      <div class="mx-auto lg:w-[70%]">
        <FeaturedOffering />
      </div>
    </div>
  </div>
</section>
