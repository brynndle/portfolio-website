---
import FeaturedOffering from './FeaturedOffering.astro';
import '@fontsource/dongle/400.css';
const { headline, lede } = Astro.props;
---
<section class="relative pb-[26px] pt-[calc(var(--nav-height)+68px)] max-lg:pb-0 max-md:pt-[97px]">
  <div class="hero-bg diagonal-cut-hero absolute inset-0" aria-hidden="true"></div>
  <div
    class="diagonal-cut-hero pointer-events-none absolute inset-0 opacity-40"
    style="background-image:url('/mist.png'); background-size:300px 300px;"
    aria-hidden="true"
  ></div>
  <div
    class="diagonal-cut-hero pointer-events-none absolute inset-0"
    style="background:radial-gradient(circle at center, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0) 70%);"
    aria-hidden="true"
  ></div>

  <div class="max-width relative flex flex-col">
    <div class="mx-auto flex w-[86%] flex-col items-center justify-center px-5 pb-10 pt-0 text-center max-md:w-full max-md:pb-8 md:px-11">
      <p id="hero-eyebrow" class="font-['Dongle'] text-xl font-semibold uppercase tracking-[0.08em] text-white/90 max-md:w-full max-md:border-t max-md:border-white/25 max-md:pb-0 max-md:mt-4 max-md:pt-10 max-md:text-base max-md:leading-[.5]">UX Design · Product Strategy · Experience Design</p>
      <h2 class="mt-5 font-['Dongle'] text-[9.65rem] font-normal leading-[0.63] -tracking-[0.0em] text-balance text-white [text-shadow:5px_5px_0_rgba(0,0,0,.24)] max-md:text-[5.35rem]">{headline}</h2>
      <p class="mt-5 w-[83%] whitespace-pre-line font-['Dongle'] text-[2rem] leading-[.8] text-white text-pretty [text-shadow:2px_2px_7px_rgba(0,0,0,.6)] max-md:w-full max-md:text-[1.75rem] max-md:leading-[.8]">{lede}</p>
    </div>

    <!-- In normal flow: mt-* is a guaranteed minimum gap below the hero copy at
         every width; -mb-* makes the card overhang the next section by a FIXED
         amount, independent of the card's own (breakpoint-dependent) height.
         CurrentProjects' pt is sized to clear that overhang + its own -mt-[65px]. -->
    <div class="relative z-10 mx-auto mt-8 -mb-[104px] w-full px-11 max-lg:px-5 max-md:mt-6 max-md:-mb-[84px]">
      <FeaturedOffering />
    </div>
  </div>
</section>
