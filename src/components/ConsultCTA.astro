---
import { BOOK_A_CONSULT_URL } from '../data/site';
---
<section class="hero-bg relative items-center gap-10 overflow-hidden px-10 py-11 max-md:grid-cols-1">
  <div class="pointer-events-none absolute inset-0 opacity-40" style="background-image:url('/mist.png'); background-size:300px 300px;" aria-hidden="true"></div>
  <div class="relative grid max-width grid-cols-[1fr_auto] items-center gap-10 px-10 max-md:grid-cols-1">
    <div>
      <h3 class="text-[34px] font-semibold -tracking-[0.02em] text-white">Something you've built isn't landing?</h3>
      <p class="mt-2.5 max-w-[56ch] text-[18px] leading-relaxed text-white">One hour, screen shared, no deck. You leave with the changes that matter most and the reasoning behind them.</p>
    </div>
    <a href={BOOK_A_CONSULT_URL} class="whitespace-nowrap bg-[#00ff1c] px-[26px] py-4 font-mono text-[15px] font-bold uppercase tracking-[0.1em] text-ink shadow-[5px_5px_0px_rgba(0,0,0,0.5)]">Book a consult →</a>
  </div>
</section>
