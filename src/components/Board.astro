---
import { getCollection, getEntry } from 'astro:content';
const entries = (await getCollection('board')).sort((a, b) => b.data.movedAt - a.data.movedAt);
const STATUS = {
  planning:   { label: 'Planning', tone: 'text-ink-3' },
  'in-build': { label: 'In build', tone: 'text-blue' },
  'looking-for-location': { label: 'Looking for location', tone: 'text-blue' },
  open:       { label: 'Taking bookings', tone: 'text-green' },
  shipped:    { label: 'Shipped', tone: 'text-ink-3' },
  launched:   { label: 'Launched', tone: 'text-green' },
  paused:     { label: 'Paused', tone: 'text-ink-4' },
  'coming-soon': { label: 'Coming to PDX this September', tone: 'text-blue' },
};

const items = await Promise.all(entries.map(async ({ data }) => {
  let thumbnail = data.thumbnail;
  if (!thumbnail && data.project) {
    const [collection, slug] = data.project.split('/') as ['work' | 'games' | 'experiences', string];
    const projectEntry = await getEntry(collection, slug);
    thumbnail = projectEntry?.data.thumbnail;
  }
  return { data, thumbnail };
}));
---
<div class="min-w-0 border-l border-rule-invert px-5 pb-16 pt-[58px] max-lg:border-l-0 max-lg:border-t md:px-10 lg:pt-[115px]">
  <div class="mb-1 flex flex-col items-stretch gap-1 md:flex-row md:items-baseline md:justify-between md:gap-3">
    <h3 class="font-display text-[2rem] font-normal leading-[1.25] -tracking-[0.01em] text-white">What I'm working on</h3>
    <span class="label text-white/60">Updated {new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}</span>
  </div>

  <div class="mt-5 flex flex-col gap-[22px]">
    {items.map(({ data, thumbnail }) => (
      <div class="flex min-w-0 flex-col items-stretch overflow-hidden rounded-[8px] bg-card shadow-plate-sm md:flex-row md:items-start">
        <div class="relative aspect-[16/9] w-full shrink-0 overflow-hidden bg-paper-2 md:aspect-square md:w-[170px]">
          {thumbnail
            ? <img src={thumbnail} alt="" class="absolute inset-0 h-full w-full object-cover" />
            : <span class="label absolute inset-0 flex items-center justify-center text-[0.875rem]">image</span>}
        </div>
        <div class="min-w-0 flex-1 px-4 pt-4 pb-[31px] md:pt-4 md:pr-4 md:pb-[31px] md:pl-[20px]">
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <span class="text-[1.5rem] font-medium">{data.title}</span>
            <span class={`font-mono text-[0.6875rem] uppercase tracking-[0.08em] ${STATUS[data.status].tone}`}>● {STATUS[data.status].label}</span>
          </div>
          <p class="mt-1.5 line-clamp-3 text-[1rem] text-ink-2">{data.lastMove}</p>
          {data.project && (
            <a href={`/${data.project}`} class="mt-1.5 inline-block font-mono text-[0.8125rem] font-bold text-blue transition-colors duration-100 hover:text-ink">View →</a>
          )}
        </div>
      </div>
    ))}
  </div>
</div>
