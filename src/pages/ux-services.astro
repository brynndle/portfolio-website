---
import BaseLayout from '../layouts/BaseLayout.astro';
import { UX_OFFERS } from '../data/uxOffers';
import '@fontsource/dongle/400.css';

const review = UX_OFFERS.review;
const engagement = UX_OFFERS.engagement;

const sharedOutcomes = [
  'Where people hesitate, misunderstand, or lose the thread',
  'Which problems matter and which rough edges can wait',
  'What to fix first, with the reasoning behind it',
];
---

<BaseLayout
  title="UX Services"
  description="Two ways to get experienced UX help: a focused $500 UX Review, or a higher-touch UX Engagement starting at $3,000."
  navOverlay
  navHideCta
>
  <section class="relative overflow-hidden pb-24 pt-[calc(var(--nav-height)+90px)] max-md:pt-[150px]">
    <div class="hero-bg absolute inset-0" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-0 opacity-40" style="background-image:url('/mist.png'); background-size:300px 300px;" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-0" style="background:radial-gradient(circle at 50% 40%, rgba(0,0,0,0.34) 0%, rgba(0,0,0,0) 70%);" aria-hidden="true"></div>

    <div class="max-width relative z-10 px-5 md:px-10 lg:pr-[42%] max-md:text-center">
      <p class="label font-['Dongle'] text-[1.25rem] font-bold leading-[1em] text-white/80 max-md:mt-2 max-md:text-[1.2rem] max-md:[text-shadow:1px_1px_4px_rgba(0,0,0,0)]">UX help for products<br class="md:hidden" /> that are almost working</p>
      <h1 class="max-md:mt-12 mt-5 max-w-[48ch] font-['Dongle'] text-[6.5rem] font-normal leading-[0.63] -tracking-[0.0em] text-balance text-white [text-shadow:6px_6px_0_rgba(0,0,0,.24)] max-lg:text-[4rem] max-md:mx-auto max-md:text-[3.75rem] max-md:[text-shadow:3px_3px_0_rgba(0,0,0,.24)]">
        <span class="max-md:hidden">Your product makes sense to you. Let's make sure it makes sense to everyone else.</span>
        <span class="hidden max-md:inline">You get it. Let's make sure everyone else does.</span>
      </h1>
      <p class="mt-7 max-md:mt-3 max-w-[56ch] font-['Dongle'] text-[2rem] max-md:leading-[.9] leading-[1] text-white text-pretty [text-shadow:2px_2px_7px_rgba(0,0,0,.6)] max-md:mx-auto max-md:text-[1.85rem] max-md:[text-shadow:1px_1px_5px_rgba(0,0,0,.6)]">
        I find the places where people get confused, stuck, or drop off, then help you decide what is worth fixing.
      </p>
      <a href="#ways-to-work" class="mt-10 inline-block bg-[#00ff1c] px-8 py-[18px] text-center font-['Dongle'] text-[1.375rem] font-bold uppercase tracking-[0.1em] text-ink shadow-[6px_6px_0px_rgba(0,0,0,0.5)] focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-[3px] focus-visible:outline-ink">
        See the two options ↓
      </a>
    </div>

    <img
      src="/images/ux-services/hero-confusion.png"
      alt="A person at a laptop surrounded by confusing product screens and question marks."
      width="1536"
      height="1024"
      decoding="async"
      class="pointer-events-none absolute inset-y-12 right-5 h-full w-[58%] object-contain object-right mix-blend-screen max-lg:relative max-lg:inset-auto max-lg:-mb-16 max-lg:-mt-8 max-lg:aspect-[4/3] max-lg:h-auto max-lg:w-full max-lg:object-cover max-lg:object-[70%_center] max-md:hidden"
    />
  </section>

  <section class="border-b border-rule bg-ink py-6">
    <div class="max-width flex flex-wrap items-center gap-x-10 gap-y-3 px-5 md:px-10">
      <span class="font-mono text-[0.6875rem] font-bold uppercase tracking-[0.18em] text-[#5fd39a]">20 years designing products for</span>
      <span class="font-mono text-[0.9375rem] tracking-[0.06em] text-white/85">Sony · Cisco · Clover · Perka · Side · Habitat for Humanity</span>
    </div>
  </section>

  <section id="ways-to-work" class="border-b border-rule bg-band px-5 py-20 md:px-10">
    <div class="max-width">
      <p class="label font-bold text-blue">Two ways to work together</p>
      <h2 class="mt-3 max-w-[25ch] text-[2.75rem] font-semibold leading-[1.06] -tracking-[0.025em] text-balance max-md:text-[2rem]">
        Choose based on how much context and collaboration you need.
      </h2>

      <div class="mt-12 grid grid-cols-2 items-stretch gap-6 max-lg:grid-cols-1">
        <article class="flex flex-col border border-rule-strong bg-card p-8 shadow-plate max-md:p-6">
          <div class="flex flex-wrap items-start justify-between gap-4 ">
            <div>
              <p class="label font-bold text-blue">Focused, fixed scope</p>
              <h3 class="mt-2 text-[2rem] font-semibold -tracking-[0.025em]">{review.name}</h3>
            </div>
            <p class="font-mono text-[2rem] font-bold leading-none text-ink">{review.priceLabel}</p>
          </div>
          <p class="mt-4 text-[1.25rem] font-semibold leading-snug text-ink">You need an expert set of eyes on one product or site.</p>
          <p class="mt-3 text-[1.0625rem] leading-relaxed text-ink-2">I use it like a first-time user, record what happens, and send you a prioritized list of changes. No meetings required.</p>
          <div class="mt-5 pt-5 border-t border-black/15">
            <p class="font-mono text-[0.75rem] font-bold uppercase tracking-[0.14em] text-ink">Choose this when</p>
            <p class="mt-2 text-[1rem] leading-relaxed text-ink">The scope is clear, you, your team or a coding agent can make the changes, and you mainly need to know what you are missing.</p>
          </div>
          <a href={review.href} class="mt-8 block bg-[#00ff1c] px-6 py-4 text-center font-mono text-[0.9375rem] font-bold uppercase tracking-[0.1em] text-ink shadow-[5px_5px_0px_rgba(0,0,0,0.5)] focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-[3px] focus-visible:outline-ink">
            {review.ctaLabel} →
          </a>
        </article>

        <article class="flex flex-col border border-black bg-ink p-8 text-white shadow-plate max-md:p-6">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <p class="label font-bold text-[#5fd39a]">Deeper, collaborative scope</p>
              <h3 class="mt-2 text-[2rem] font-semibold -tracking-[0.025em]">{engagement.name}</h3>
            </div>
            <p class="font-mono text-[2rem] font-bold leading-none text-white">{engagement.priceLabel}</p>
          </div>
          <p class="mt-4 text-[1.25rem] font-semibold leading-snug text-white">The problem needs context, conversation, and follow-through.</p>
          <p class="mt-3 text-[1.0625rem] leading-relaxed text-white">I learn the context, review the important journeys, and work through the questions with you and your team.</p>
          <div class="mt-5 pt-4 border-t border-white/25">
            <p class="font-mono text-[0.75rem] font-bold uppercase tracking-[0.14em] text-white">Choose this when</p>
            <p class="mt-2 text-[1rem] leading-relaxed text-white">The product is complex, the right answer depends on context, or you want help making decisions after the review.</p>
          </div>
          <a href={engagement.href} class="mt-8 block bg-[#00ff1c] px-6 py-4 text-center font-mono text-[0.9375rem] font-bold uppercase tracking-[0.1em] text-ink shadow-[5px_5px_0px_rgba(0,0,0,0.5)] focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-[3px] focus-visible:outline-white">
            {engagement.ctaLabel} →
          </a>
        </article>
      </div>
    </div>
  </section>

  <section class="border-b border-rule bg-white px-5 py-10 md:px-10">
    <div class="max-width grid grid-cols-[auto_1fr] items-center gap-10 max-lg:grid-cols-1 max-lg:gap-6">
      <div>
        <p class="label font-bold text-blue">What stays the same</p>
        <h2 class="mt-2 text-[1.5rem] font-semibold leading-tight -tracking-[0.015em]">Same eyes. Different involvement.</h2>
      </div>
      <ul class="grid grid-cols-3 gap-6 border-l border-rule-strong pl-10 max-lg:border-l-0 max-lg:border-t max-lg:pl-0 max-lg:pt-6 max-md:grid-cols-1 max-md:gap-3">
        {sharedOutcomes.map((item) => (
          <li class="flex gap-3 text-[1rem] leading-relaxed text-ink-2">
            <span class="shrink-0 font-mono font-bold text-blue">→</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="border-b border-rule bg-[#f3e8ff] px-5 py-20 md:px-10">
    <div class="max-width grid grid-cols-[0.75fr_1.25fr] gap-14 max-lg:grid-cols-1 max-lg:gap-8">
      <div>
        <p class="label font-bold text-blue">Who's doing the looking</p>
        <h2 class="mt-3 max-w-[18ch] text-[2.75rem] font-semibold leading-[1.06] -tracking-[0.025em] text-balance max-md:text-[2rem]">
          I've spent 20 years finding the part that isn't working.
        </h2>
      </div>
      <div>
        <p class="max-w-[62ch] text-[1.1875rem] leading-relaxed text-ink-2 text-pretty">
          I've designed products for Sony, Clover, Garner Health, Side, and Habitat for Humanity. My job has usually been the same: understand where the experience breaks down, then turn that into changes a team can actually ship.
        </p>
        <ul class="mt-8 space-y-5 border-t border-rule-strong pt-7">
          <li class="flex gap-4 text-[1.1875rem] leading-relaxed text-ink-2"><span class="shrink-0 font-mono font-bold text-blue">→</span><span>Tripled adjudication rates at Garner Health</span></li>
          <li class="flex gap-4 text-[1.1875rem] leading-relaxed text-ink-2"><span class="shrink-0 font-mono font-bold text-blue">→</span><span>Increased transaction throughput by 200% at Side</span></li>
          <li class="flex gap-4 text-[1.1875rem] leading-relaxed text-ink-2"><span class="shrink-0 font-mono font-bold text-blue">→</span><span>Helped Habitat for Humanity make it easier for visitors to become donors</span></li>
        </ul>
        <a href="/work" class="mt-7 inline-block border-b border-blue pb-0.5 font-mono text-[0.8125rem] font-bold uppercase tracking-[0.1em] text-blue">See my work →</a>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-ink px-5 py-24 md:px-10">
    <div class="pointer-events-none absolute inset-0 opacity-25" style="background-image:url('/mist.png'); background-size:300px 300px;" aria-hidden="true"></div>
    <div class="max-width relative text-center">
      <h2 class="mx-auto max-w-[21ch] font-['Dongle'] text-[5rem] font-normal leading-[0.78] -tracking-[0.02em] text-balance text-white max-md:text-[3rem]">Start with the amount of help you actually need.</h2>
      <div class="mt-10 flex flex-wrap justify-center gap-5">
        <a href={review.href} class="bg-[#00ff1c] px-8 py-4 font-mono text-[0.9375rem] font-bold uppercase tracking-[0.1em] text-ink shadow-[5px_5px_0px_rgba(0,0,0,0.5)]">{review.name} · {review.priceLabel} →</a>
        <a href={engagement.href} class="border-2 border-white px-8 py-4 font-mono text-[0.9375rem] font-bold uppercase tracking-[0.1em] text-white">{engagement.name} · {engagement.priceLabel} →</a>
      </div>
    </div>
  </section>
</BaseLayout>
