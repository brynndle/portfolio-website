---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CurrentProjects from '../components/CurrentProjects.astro';
import Board from '../components/Board.astro';
import BioStrip from '../components/BioStrip.astro';
import ConsultCTA from '../components/ConsultCTA.astro';
---

<BaseLayout title="Home" description="Brynn Caputo — experience & product design." navOverlay>
  <Hero
    headline="I design games, immersive theater, and physical worlds with twenty years of software behind all of it."
    lede="I've solved problems for major corporations and small start-ups and now I want to offer my services to independant creators who are vibe coding amazing products but need help with the UX."
  />
  <CurrentProjects title="Recently Launched" moreHref="/work" moreLabel="Full catalog →" />
  <section id="board" class="max-width grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)] border-b border-rule max-lg:grid-cols-1">
    <BioStrip />
    <Board />
  </section>
  <ConsultCTA />
</BaseLayout>
