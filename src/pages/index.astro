---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CurrentProjects from '../components/CurrentProjects.astro';
import Board from '../components/Board.astro';
import BioStrip from '../components/BioStrip.astro';
import ConsultCTA from '../components/ConsultCTA.astro';
---

<BaseLayout title="Home" description="Brynn Caputo — experience & product design." navOverlay>
  <Hero
    headline="I make weird ideas feel real."
    lede="Blending strategy, design, and technology to turn ambitious ideas into experiences that resonate."
  />
  <CurrentProjects title="Recently Launched" moreHref="/work" moreLabel="Full catalog →" />
  <section class="relative -mt-[65px] overflow-hidden">
    <div class="hero-bg diagonal-cut-board absolute inset-x-0 -bottom-1 top-0" aria-hidden="true"></div>
    <div class="diagonal-cut-board pointer-events-none absolute inset-x-0 -bottom-1 top-0 opacity-40" style="background-image:url('/mist.png'); background-size:300px 300px;" aria-hidden="true"></div>
    <div class="diagonal-cut-board pointer-events-none absolute inset-x-0 -bottom-1 top-0 bg-black/30" aria-hidden="true"></div>
    <div id="board" class="max-width relative grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)] max-lg:grid-cols-1">
      <BioStrip />
      <Board />
    </div>
  </section>
  <ConsultCTA />
</BaseLayout>
