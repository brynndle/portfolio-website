---
// Live page: /ux-audit. $500 Small Company tier.
// Promoted from src/pages/small-company-a.astro (that file remains as the
// concept-review copy; this one is the shipped page traffic actually hits).
// Structure: hero, problem, what you get, positioning, close. Register sits
// between the two neighbouring tiers: warmer and more personal than the
// $3,000 page, less pressure than the Vibe Coder direct-response concept.
// No testimonials, guarantee, turnaround, or capacity claims appear on this page,
// because none have been confirmed for this tier. See the TODO comments.
import BaseLayout from '../layouts/BaseLayout.astro';
import { SMALL_COMPANY_OFFER } from '../data/smallCompanyOffer';
import { getAlternativeUxOffer, UX_OFFERS } from '../data/uxOffers';
import '@fontsource/dongle/400.css';

const tier = SMALL_COMPANY_OFFER;
const review = UX_OFFERS.review;
const engagement = getAlternativeUxOffer('review');

// Ported from CheckoutOffer.astro's "The process" section, same four steps.
const process = [
  ['Pay', 'Checkout above, secured by Stripe.'],
  ['Give me the context', "After payment, you'll share the product, the important links, and what already feels off."],
  ["I follow up if I need to", "If I need more context, I’ll reach out with a few specific questions."],
  ['I send the review', 'You get the recording and the changes that matter most, with the reasoning behind them.'],
];

const whatYouGet = [
  'A one-hour video of me using your product or site and talking through every place I hesitate, guess wrong, or get stuck',
  'Feedback on copy, usability, accessibility, and the path to purchase',
  'A clear distinction between harmless rough edges and problems that interrupt trust or momentum',
  'Recommendations ranked by impact and effort',
  'Direct answers to the parts you already suspect are not working',
];
---

<BaseLayout
  title="UX Review"
  description="A focused $500 review of one product or site, with a recorded walkthrough and prioritized recommendations."
  navOverlay
  navHideCta
>
  <!-- HERO -->
  <section class="relative overflow-hidden pb-24 pt-[calc(var(--nav-height)+90px)] max-md:pb-0 max-md:pt-[150px]">
    <div class="hero-bg absolute inset-0" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute inset-0 opacity-40"
      style="background-image:url('/mist.png'); background-size:300px 300px;"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute inset-0"
      style="background:radial-gradient(circle at 50% 40%, rgba(0,0,0,0.34) 0%, rgba(0,0,0,0) 70%);"
      aria-hidden="true"
    ></div>

    <div class="max-width relative px-5 md:px-10 max-md:text-center">
      <p class="label font-['Dongle'] text-[1.5rem] font-bold text-white max-md:text-[1rem] max-md:[text-shadow:1px_1px_4px_rgba(0,0,0,.55)]">UX Review · For one product or site</p>
      <h1 class="mt-5 max-w-[40ch] font-['Dongle'] text-[6.5rem] font-normal leading-[0.63] -tracking-[0.0em] text-balance text-white [text-shadow:6px_6px_0_rgba(0,0,0,.24)] max-lg:text-[4rem] max-md:mx-auto max-md:text-[4rem] max-md:[text-shadow:3px_3px_0_rgba(0,0,0,.24)]">
        You built it. I'll show you where people get stuck.
      </h1>
      <p class="mt-2 max-w-[54ch] font-['Dongle'] text-[2rem] leading-[.9] text-white text-pretty [text-shadow:2px_2px_7px_rgba(0,0,0,.6)] max-md:mx-auto max-md:text-[1.75rem] max-md:[text-shadow:1px_1px_5px_rgba(0,0,0,.6)]">
        I use your product like a first-time user, record what happens, and send
        you the fixes that matter most.
      </p>
      <div class="hero-cta-notch mt-8 max-md:mb-5 max-md:bg-black/40 max-md:px-6 max-md:py-7">
        <p class="font-mono text-[0.8em] font-bold uppercase tracking-[0.12em] text-white [text-shadow:2px_2px_7px_rgba(0,0,0,.6)] max-md:[text-shadow:1px_1px_5px_rgba(0,0,0,.6)]">
          {tier.priceLabel} flat · recorded review · delivered in {tier.turnaround}
        </p>

        <div class="mt-5 flex flex-wrap items-center gap-x-7 gap-y-4 max-md:justify-center">
          <a
            href={tier.checkoutHref}
            class="whitespace-nowrap bg-[#00ff1c] px-8 py-[18px] text-center font-['Dongle'] text-[1.375rem] font-bold uppercase tracking-[0.1em] text-ink shadow-[6px_6px_0px_rgba(0,0,0,0.5)] focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-[3px] focus-visible:outline-ink max-md:mx-1 max-md:w-full max-md:whitespace-normal max-md:px-2"
          >
            Get the {review.name} · {tier.priceLabel}<span class="max-md:hidden"> →</span>
          </a>
          <a href="#what-you-get" class="border-b-2 border-white/60 pb-1 font-mono text-[0.9375rem] font-bold uppercase tracking-[0.1em] text-white hover:border-white hover:text-white">
            See what I look for ↓
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CREDIBILITY BAR -->
  <section class="border-b border-rule bg-ink py-6">
    <div class="max-width flex flex-wrap items-center gap-x-10 gap-y-3 px-5 md:px-10">
      <span class="font-mono text-[0.6875rem] font-bold uppercase tracking-[0.18em] text-[#5fd39a]">20 years of building products for</span>
      <span class="font-mono text-[0.9375rem] tracking-[0.06em] text-white/85">Sony · Cisco · Clover · Perka · Side · Habitat for Humanity</span>
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="border-b border-rule px-5 py-20 md:px-10">
    <div class="max-width grid grid-cols-1 items-center gap-10 md:grid-cols-[1fr_0.8fr] md:gap-14">
      <div>
        <p class="label font-bold text-blue">Too close to see it</p>
        <h2 class="mt-3 max-w-[24ch] text-[2.75rem] font-semibold leading-[1.06] -tracking-[0.025em] text-balance max-md:text-[2rem]">
          You know the product. That is why the friction gets hard to spot.
        </h2>
        <p class="mt-8 max-w-[58ch] text-[1.25rem] leading-relaxed text-ink-2 text-pretty">
          You know why each choice was made. A new user does not. They only feel
          the moment when the next step is unclear or the product asks too much.
        </p>
        <p class="mt-5 max-w-[58ch] text-[1.25rem] leading-relaxed text-ink-2 text-pretty">
          I look at it cold, find where trust or momentum breaks, and tell you
          what is worth fixing first.
        </p>
      </div>

      <img
        src="/lost-at-the-crossroads.png"
        alt="A person stops at a fork in a glowing path, hand on her head, facing a signpost whose arrows point three different ways. A barricade blocks one route, another loops back on itself into a hole, and banknotes with wings fly away toward a distant flag."
        width="806"
        height="806"
        loading="lazy"
        decoding="async"
        class="h-auto w-full max-w-[520px] justify-self-center md:max-w-none"
      />
    </div>
  </section>

  <!-- PROCESS -->
  <section class="border-b border-rule bg-white px-5 py-10 md:px-10">
    <div class="max-width">
      <h2 class="text-[1.75rem] font-semibold -tracking-[0.015em]">The process</h2>
      <ol class="mt-5 grid grid-cols-4 gap-8 border-t border-rule-strong pt-6 max-md:grid-cols-1 max-md:gap-5">
        {process.map(([label, body], i) => (
          <li>
            <h3 class="flex items-baseline gap-2 text-[1rem] font-semibold -tracking-[0.01em]">
              <span class="font-mono text-[1rem] font-bold text-blue">{String(i + 1).padStart(2, '0')}</span>
              {label}
            </h3>
            <p class="mt-1 max-w-[30ch] text-[0.9375rem] leading-relaxed text-ink-2 text-pretty">{body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- TODO REQUIRES BRYNN'S SIGN-OFF: testimonial band goes here. One or two real
       one-sentence quotes from a creator-tier buyer, with name and product. Do not
       ship invented quotes. -->

  <!-- WHAT YOU GET -->
  <section id="what-you-get" class="border-b border-rule bg-band px-5 py-20 md:px-10">
    <div class="max-width grid grid-cols-[1.3fr_1fr] items-start gap-16 max-lg:grid-cols-1 max-lg:gap-10">
      <div>
        <p class="label font-bold text-blue">What you get</p>
        <h2 class="mt-3 max-w-[24ch] text-[2.75rem] font-semibold leading-[1.06] -tracking-[0.025em] text-balance max-md:text-[2rem]">
          A clear list of what to fix, in the order that matters.
        </h2>
        <ul class="mt-10 space-y-6 border-t border-rule-strong pt-8">
          {whatYouGet.map((item, i) => (
            <li class="flex gap-5">
              <span class="mt-[5px] shrink-0 font-mono text-[0.8125rem] font-bold text-blue">{String(i + 1).padStart(2, '0')}</span>
              <p class="max-w-[52ch] text-[1.1875rem] leading-relaxed text-ink-2 text-pretty">{item}</p>
            </li>
          ))}
        </ul>
      </div>

      <aside class="border border-rule-strong bg-card p-9 shadow-plate max-md:p-6 lg:sticky lg:top-[calc(var(--nav-height)+24px)]">
        <p class="label font-bold text-ink-3">{review.name}</p>
        <p class="mt-4 font-mono text-[3.5rem] font-bold leading-none text-ink">{tier.priceLabel}</p>
        <p class="mt-2 text-[0.9375rem] text-ink-3">One flat price, one hour of recorded feedback and recommendations.</p>
        <p class="mt-4 border-t border-rule pt-4 font-mono text-[0.8125rem] uppercase tracking-[0.12em] text-ink-3">Delivered in {tier.turnaround}</p>
        <a
          href={tier.checkoutHref}
          class="mt-6 block w-full bg-[#00ff1c] px-6 py-4 text-center font-mono text-[0.9375rem] font-bold uppercase tracking-[0.1em] text-ink shadow-[5px_5px_0px_rgba(0,0,0,0.5)] focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-[3px] focus-visible:outline-ink"
        >
          Get the {review.name} · {tier.priceLabel} →
        </a>
      </aside>
    </div>
  </section>

  <!-- HIGHER-TOUCH ALTERNATIVE -->
  <section class="border-b border-rule bg-ink px-5 py-16 md:px-10">
    <div class="max-width grid grid-cols-[1fr_auto] items-center gap-10 max-md:grid-cols-1">
      <div>
        <p class="label font-bold text-[#5fd39a]">Need more than a review?</p>
        <h2 class="mt-3 max-w-[44ch] text-[2.25rem] font-semibold leading-[1.08] -tracking-[0.02em] text-balance text-white">If the product is bigger or you want to work through the decisions together, choose the UX Engagement.</h2>
        <p class="mt-4 max-w-[58ch] text-[1.125rem] leading-relaxed text-white/75">It starts at $3,000 and includes a deeper review, live working sessions, and time for follow-up questions.</p>
      </div>
      <a href={engagement.href} class="whitespace-nowrap border-2 border-white px-7 py-4 text-center font-mono text-[0.9375rem] font-bold uppercase tracking-[0.1em] text-white">{engagement.ctaLabel} →</a>
    </div>
  </section>

  <!-- POSITIONING -->
  <section class="border-b border-rule bg-paper-2 px-5 py-20 md:px-10">
    <div class="max-width grid grid-cols-1 items-center gap-10 md:grid-cols-[1fr_0.8fr] md:gap-14">
      <div>
        <p class="label font-bold text-blue">Before you rebuild it</p>
        <h2 class="mt-3 max-w-[22ch] text-[2.75rem] font-semibold leading-[1.06] -tracking-[0.025em] text-balance max-md:text-[2rem]">
          Make the thing you already built work harder.
        </h2>
        <p class="mt-8 max-w-[58ch] text-[1.25rem] leading-relaxed text-ink-2 text-pretty">
          You may not need a redesign, a new platform, or another round of
          features. Often the valuable fixes are smaller: clearer language, a
          better order, fewer decisions, and a more obvious next step.
        </p>
        <p class="mt-5 max-w-[58ch] text-[1.25rem] leading-relaxed text-ink-2 text-pretty">
          I find those changes and put them in the order that matters.
        </p>
      </div>

      <img
        src="/tune-radio.png"
        alt="A hand adjusts the dial on a radio, tuning it rather than replacing it."
        width="806"
        height="672"
        loading="lazy"
        decoding="async"
        class="h-auto w-full max-w-[520px] justify-self-center md:max-w-none"
      />
    </div>
  </section>

  <!-- WHO I AM -->
  <section class="border-b border-rule px-5 py-20 md:px-10">
    <div class="max-width grid grid-cols-[1.3fr_1fr] items-start gap-16 max-lg:grid-cols-1 max-lg:gap-10">
      <div>
        <p class="label font-bold text-blue">Why work with me?</p>
        <h2 class="mt-3 max-w-[24ch] text-[2.75rem] font-semibold leading-[1.06] -tracking-[0.025em] text-balance max-md:text-[2rem]">
          I'm Brynn.
        </h2>
        <p class="mt-6 max-w-[62ch] text-[1.1875rem] leading-relaxed text-ink-2 text-pretty">
          I've spent 20 years helping startups ship better products. A few recent
          examples:
        </p>
        <ul class="mt-5 max-w-[62ch] space-y-2.5 text-[1.1875rem] leading-relaxed text-ink-2">
          <li class="flex gap-3"><span class="mt-[3px] shrink-0 font-mono text-[0.6875rem] text-blue">→</span><span>Tripled adjudication rates at Garner Health</span></li>
          <li class="flex gap-3"><span class="mt-[3px] shrink-0 font-mono text-[0.6875rem] text-blue">→</span><span>Increased transaction throughput by 200% at Side Inc</span></li>
          <li class="flex gap-3"><span class="mt-[3px] shrink-0 font-mono text-[0.6875rem] text-blue">→</span><span>Made it easier for non-profits to turn website visits into donations</span></li>
        </ul>
        <p class="mt-5 max-w-[62ch] text-[1.1875rem] leading-relaxed text-ink-2 text-pretty">
          I've spent most of those twenty years getting very good at seeing a
          product from the user's side. Where they hesitate, what they
          misunderstand, what they need to trust you, and what finally makes
          something feel worth paying for.
        </p>
        <p class="mt-4 max-w-[62ch] text-[1.1875rem] leading-relaxed text-ink-2 text-pretty">
          That's the lens I bring to your product.
        </p>
        <a href="/about" class="mt-6 inline-block border-b border-blue pb-0.5 font-mono text-[0.8125rem] font-bold uppercase tracking-[0.1em] text-blue">Full background →</a>
      </div>

      <aside class="border border-rule-strong bg-card p-9 shadow-plate max-md:p-6 lg:sticky lg:top-[calc(var(--nav-height)+24px)]">
        <p class="label font-bold text-ink-3">{review.name}</p>
        <p class="mt-4 font-mono text-[3.5rem] font-bold leading-none text-ink">{tier.priceLabel}</p>
        <p class="mt-2 text-[0.9375rem] text-ink-3">One flat price, one hour of recorded feedback and recommendations.</p>
        <p class="mt-4 border-t border-rule pt-4 font-mono text-[0.8125rem] uppercase tracking-[0.12em] text-ink-3">Delivered in {tier.turnaround}</p>
        <a
          href={tier.checkoutHref}
          class="mt-6 block w-full bg-[#00ff1c] px-6 py-4 text-center font-mono text-[0.9375rem] font-bold uppercase tracking-[0.1em] text-ink shadow-[5px_5px_0px_rgba(0,0,0,0.5)] focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-[3px] focus-visible:outline-ink"
        >
          Get the {review.name} · {tier.priceLabel} →
        </a>
      </aside>
    </div>
  </section>

  <!-- CLOSE -->
  <section class="relative overflow-hidden bg-ink px-5 py-24 md:px-10 max-md:pb-32">
    <div
      class="pointer-events-none absolute inset-0 opacity-25"
      style="background-image:url('/mist.png'); background-size:300px 300px;"
      aria-hidden="true"
    ></div>
    <div class="max-width relative text-center">
      <h2 class="mx-auto max-w-[22ch] font-['Dongle'] text-[5rem] font-normal leading-[0.78] -tracking-[0.02em] text-balance text-white max-md:text-[3rem]">
        Know what to fix before you rebuild.
      </h2>
      <p class="mx-auto mt-6 max-w-[54ch] text-[1.25rem] leading-relaxed text-white/85 text-pretty">
        Get a clear view of the friction, the harmless rough edges, and the few
        changes worth making first.
      </p>
      <a
        href={tier.checkoutHref}
        class="mt-10 inline-block whitespace-nowrap bg-[#00ff1c] px-9 py-5 text-center font-mono text-[1rem] font-bold uppercase tracking-[0.1em] text-ink shadow-[6px_6px_0px_rgba(0,0,0,0.5)] focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-[3px] focus-visible:outline-ink"
      >
        Get the {review.name} · {tier.priceLabel} →
      </a>
    </div>
  </section>

  <!-- MOBILE STICKY CTA -->
  <div class="fixed bottom-0 inset-x-0 z-40 md:hidden border-t border-rule bg-paper px-4 py-3">
    <a
      href={tier.checkoutHref}
      class="block w-full bg-[#00ff1c] px-4 py-3.5 text-center font-mono text-[0.9375rem] font-bold uppercase tracking-[0.1em] text-ink shadow-[4px_4px_0px_rgba(0,0,0,0.5)] focus-visible:outline focus-visible:outline-[3px] focus-visible:outline-offset-[3px] focus-visible:outline-ink"
    >
      Get the {review.name} · {tier.priceLabel} →
    </a>
  </div>
</BaseLayout>
