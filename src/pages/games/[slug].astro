---
import { getCollection } from 'astro:content';
import ProjectDetail from '../../components/ProjectDetail.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('games')).sort((a, b) => a.data.order - b.data.order);
  return entries.map((entry, i) => {
    const prevEntry = entries[i - 1];
    const nextEntry = entries[i + 1];
    return {
      params: { slug: entry.id },
      props: {
        entry,
        prev: prevEntry && { title: prevEntry.data.title, href: `/games/${prevEntry.id}` },
        next: nextEntry && { title: nextEntry.data.title, href: `/games/${nextEntry.id}` },
      },
    };
  });
}

const { entry, prev, next } = Astro.props;
---

<ProjectDetail entry={entry} backHref="/games" backLabel="Games" prev={prev} next={next} />
