# .env.example
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_VIBE_CODER=
STRIPE_PRICE_ID_SMALL_COMPANY=
STRIPE_PRICE_ID_STARTUP=
# Payment Link URLs are read at BUILD time (Astro frontmatter), not just runtime —
# missing any of these fails the build (see src/data/checkoutTiers.ts).
STRIPE_PAYMENT_LINK_VIBE_CODER=
STRIPE_PAYMENT_LINK_SMALL_COMPANY=
STRIPE_PAYMENT_LINK_STARTUP=
RESEND_API_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=
BLOB_READ_WRITE_TOKEN=
SITE_URL=https://brynncaputo.com
# Overrides the next-steps email's From address (defaults to hi@brynncaputo.com,
# which requires a verified sending domain in Resend). Use Resend's shared test
# domain until the real domain is verified, e.g. "Brynn Caputo <onboarding@resend.dev>".
EMAIL_FROM=
