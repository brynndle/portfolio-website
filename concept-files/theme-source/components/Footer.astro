---
import { BOOK_A_CONSULT_URL, AVAILABLE } from '../data/site';
const columns = [
  { head: 'Work', links: [['Project catalog', '/work'], ['Case studies', '/work'], ['Games', '/games'], ['Experiences', '/experiences']] },
  { head: 'More', links: [['The board', '/#board'], ['About', '/about'], ['Résumé (PDF)', '/brynn-caputo.pdf'], ['Now', '/#board']] },
  { head: 'Elsewhere', links: [['Email', 'mailto:hi@brynncaputo.com'], ['LinkedIn', '#'], ['Instagram', '#'], ['itch.io', '#']] },
];
---
<footer class="bg-ink text-paper">
  <div class="grid grid-cols-[1.4fr_1fr_1fr_1fr] gap-12 border-b border-rule-invert px-10 pb-11 pt-13 max-md:grid-cols-2">
    <div>
      <div class="text-xl font-semibold -tracking-[0.015em]">Brynn Caputo</div>
      <p class="mt-3 max-w-[34ch] text-[14.5px] leading-relaxed text-paper/60 text-pretty">Product and experience design. Currently taking two consult slots a month, and building three things in public.</p>
      {AVAILABLE && (
        <div class="mt-[18px] flex items-center gap-2.5">
          <span class="block h-2.5 w-2.5 bg-green-dark"></span>
          <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-green-dark">Available for work</span>
        </div>
      )}
    </div>
    {columns.map((col) => (
      <div class="flex flex-col gap-3">
        <div class="mb-0.5 font-mono text-[11px] uppercase tracking-[0.14em] text-paper/45">{col.head}</div>
        {col.links.map(([label, href]) => <a href={href} class="text-[14.5px] text-paper/85 transition-colors duration-100 hover:text-paper">{label}</a>)}
      </div>
    ))}
  </div>
  <div class="grid grid-cols-[1fr_auto] items-center gap-8 px-10 pb-[30px] pt-[26px] max-md:grid-cols-1">
    <div class="flex flex-wrap gap-6 font-mono text-[11px] uppercase tracking-[0.1em] text-paper/45">
      <span>© {new Date().getFullYear()} Brynn Caputo</span>
      <a href="/colophon" class="text-paper/45 hover:text-paper">Colophon</a>
      <a href="/privacy" class="text-paper/45 hover:text-paper">Privacy</a>
      <span>Built in public</span>
    </div>
    <a href={BOOK_A_CONSULT_URL} class="whitespace-nowrap bg-blue px-6 py-3.5 font-mono text-xs font-medium uppercase tracking-[0.1em] text-paper">Book a consult →</a>
  </div>
</footer>
