---
import { BOOK_A_CONSULT_URL } from '../data/site';
---
<section class="grid grid-cols-[1fr_auto] items-center gap-10 bg-paper-2 px-10 py-11 max-md:grid-cols-1">
  <div>
    <h3 class="text-[28px] font-semibold -tracking-[0.02em]">Something you've built isn't landing?</h3>
    <p class="mt-2.5 max-w-[56ch] text-[15px] leading-relaxed text-ink-2">One hour, screen shared, no deck. You leave with the three changes that matter most and the reasoning behind them.</p>
  </div>
  <a href={BOOK_A_CONSULT_URL} class="whitespace-nowrap bg-blue px-[26px] py-4 font-mono text-[13px] uppercase tracking-[0.1em] text-paper">Book a consult →</a>
</section>
